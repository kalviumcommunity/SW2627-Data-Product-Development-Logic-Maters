# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment variables (keep .env.example committed) ---
.env
.env.local
.env.*.local

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Project data ---
# Raw and processed datasets are pipeline artifacts and are not committed.
# Sample datasets (data/sample/) are intentionally committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Reports generated at runtime ---
reports/*
!reports/.gitkeep
