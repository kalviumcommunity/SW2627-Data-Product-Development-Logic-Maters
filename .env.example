# Cascading Delay Intelligence — environment configuration template
#
# PLACEHOLDERS ONLY: every value below is an example/placeholder.
# Copy this file to `.env` and fill in real values locally.
# Never commit the real `.env` file (it is ignored by .gitignore).

# --- Database (future feature: SQL analytics) ---
DATABASE_URL=

# --- Email / SMTP (email reporting via reports/email_report.py) ---
# Canonical names are REPORT_*; legacy EMAIL_* fallbacks are also accepted.
# Copy this file to `.env` and fill in real values locally.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Legacy aliases (still accepted as fallbacks; prefer REPORT_* above):
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_RECIPIENT=
